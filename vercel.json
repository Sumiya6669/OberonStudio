{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|admin$|admin/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
