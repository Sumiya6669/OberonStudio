# Серверные переменные для формы заявок (Vercel → Settings → Environment Variables).
# БЕЗ префикса VITE_ — эти значения нужны только serverless-функции /api/lead
# и в клиентский бандл не попадают.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата или канала, куда приходят заявки (узнать: напишите боту @userinfobot)
TELEGRAM_CHAT_ID=
