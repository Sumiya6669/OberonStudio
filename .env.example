# ─────────────────────────────────────────────────────────────────────────────
# Серверные переменные (Vercel → Settings → Environment Variables).
# БЕЗ префикса VITE_ — нужны только serverless-функции /api/lead
# и в клиентский бандл не попадают.
# ─────────────────────────────────────────────────────────────────────────────

# Аварийный сигнал в Telegram, если база не приняла заявку (/api/lead). По умолчанию
# ВЫКЛЮЧЕН; '1' — включить. Даже включённый, шлёт только метку без персональных данных.
LEAD_TELEGRAM_FALLBACK=
# Токен бота от @BotFather и чат — нужны только для сигнала выше
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase для записи заявок и отзывов.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Ключ service_role (или secret-ключ sb_secret_...) — ТОЛЬКО здесь, на сервере, никогда с VITE_.
# Нужен для счётчиков частоты /api/chat (миграция 061) и записи заявки от имени сервера (062).
SUPABASE_SERVICE_ROLE_KEY=

# Соль хэша IP посетителя (openssl rand -hex 32). Без неё хэш IP не считается и не пишется.
IP_HASH_SALT=
# Ключ подписи реплик консультанта (openssl rand -hex 32): без него история чата
# берётся только из реплик посетителя.
CHAT_HISTORY_KEY=
# Пределы /api/chat (необязательно): на IP в час / в сутки, на всех в сутки.
CHAT_PER_IP_HOUR=20
CHAT_PER_IP_DAY=60
CHAT_DAILY_CAP=400

# ─────────────────────────────────────────────────────────────────────────────
# Клиентские переменные для панели /admin. Префикс VITE_ обязателен —
# без него Vite не отдаст их в браузер.
#
# Это ПУБЛИЧНЫЕ значения: строки отсекает RLS по вошедшему пользователю,
# а не секретность ключа. Ключ service_role в браузер не попадает никогда.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Яндекс Метрика. Номер счётчика — публичный (он и так виден в коде страницы).
# Пока пусто, счётчика и баннера согласия на сайте нет.
VITE_YM_ID=
# Секретный токен Measurement Protocol (Метрика → Настройки): цель «лид» с сервера.
YM_MS_TOKEN=
